{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-factcheck.mjs\"",
            "timeout": 90,
            "statusMessage": "conducted-lite: fact-check (roadmap derived, claims verified from git)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-glance.mjs\"",
            "timeout": 15,
            "statusMessage": "conducted-lite: local glance"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-end-record.mjs\"",
            "timeout": 120,
            "statusMessage": "conducted-lite: session-end checks and record"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/conductor-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
