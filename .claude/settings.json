{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git for-each-ref*)",
      "Bash(git branch --list*)",
      "Bash(git worktree list*)",
      "Bash(git ls-files*)",
      "Bash(git config --get*)",
      "Bash(node .claude/tests/*)",
      "Bash(node .claude/scripts/*)",
      "Bash(node .claude/hooks/*)",
      "Bash(node --version)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-factcheck.mjs\"",
            "timeout": 90,
            "statusMessage": "conducted-lite: fact-check (roadmap derived, claims verified from git)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-glance.mjs\"",
            "timeout": 15,
            "statusMessage": "conducted-lite: local glance"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-end-record.mjs\"",
            "timeout": 120,
            "statusMessage": "conducted-lite: session-end checks and record"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/conductor-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
